{
  "info": {
    "_postman_id": "b25e9042-5420-4c25-99d7-3e83c3dc9672",
    "name": "Tugas 2 - Eksplorasi HTTP",
    "description": "Collection untuk memverifikasi API contract, success response, dan error response pada REST API tasks. Tidak memerlukan credential.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Success responses",
      "item": [
        {
          "name": "GET - Daftar tasks (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code adalah 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response adalah JSON dan contract sesuai', function () {",
                  "    pm.response.to.be.json;",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data).to.be.an('array');",
                  "    pm.expect(body.meta.count).to.eql(body.data.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            },
            "description": "Mengambil seluruh task sesuai API contract."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Accept", "value": "application/json" }],
                "url": {
                  "raw": "{{base_url}}/api/tasks",
                  "host": ["{{base_url}}"],
                  "path": ["api", "tasks"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json; charset=utf-8" }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"id\": 1,\n      \"title\": \"Mempelajari dasar HTTP\",\n      \"completed\": true\n    },\n    {\n      \"id\": 2,\n      \"title\": \"Menguji API dengan Postman\",\n      \"completed\": false\n    }\n  ],\n  \"meta\": {\n    \"count\": 2\n  }\n}"
            }
          ]
        },
        {
          "name": "POST - Buat task (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code adalah 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Task baru mengikuti contract', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.id).to.be.a('number');",
                  "    pm.expect(body.data.title).to.eql('Mendokumentasikan API contract');",
                  "    pm.collectionVariables.set('task_id', String(body.data.id));",
                  "});",
                  "pm.test('Header Location tersedia', function () {",
                  "    pm.expect(pm.response.headers.get('Location')).to.eql('/api/tasks/' + pm.response.json().data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mendokumentasikan API contract\",\n  \"completed\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            },
            "description": "Membuat task baru dan menyimpan id response ke variable task_id."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Mendokumentasikan API contract\",\n  \"completed\": false\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/tasks",
                  "host": ["{{base_url}}"],
                  "path": ["api", "tasks"]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json; charset=utf-8" },
                { "key": "Location", "value": "/api/tasks/3" }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Tugas berhasil dibuat.\",\n  \"data\": {\n    \"id\": 3,\n    \"title\": \"Mendokumentasikan API contract\",\n    \"completed\": false\n  }\n}"
            }
          ]
        },
        {
          "name": "GET - Detail task hasil create (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code adalah 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('ID sesuai variable collection', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(String(body.data.id)).to.eql(pm.collectionVariables.get('task_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/tasks/{{task_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "{{task_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error responses",
      "item": [
        {
          "name": "POST - Validasi gagal (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code adalah 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Error mengikuti contract', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
                  "    pm.expect(body.error.details.title).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/tasks",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"]
            },
            "description": "Membuktikan error validasi saat title melanggar API contract."
          },
          "response": [
            {
              "name": "422 Unprocessable Content",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"title\": \"\"\n}" },
                "url": {
                  "raw": "{{base_url}}/api/tasks",
                  "host": ["{{base_url}}"],
                  "path": ["api", "tasks"]
                }
              },
              "status": "Unprocessable Content",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [
                { "key": "Content-Type", "value": "application/json; charset=utf-8" }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"error\": {\n    \"code\": \"VALIDATION_ERROR\",\n    \"message\": \"Data yang dikirim tidak valid.\",\n    \"details\": {\n      \"title\": \"Title wajib berupa teks minimal 3 karakter.\"\n    }\n  }\n}"
            }
          ]
        },
        {
          "name": "GET - Task tidak ditemukan (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code adalah 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Kode error TASK_NOT_FOUND', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "    pm.expect(body.error.code).to.eql('TASK_NOT_FOUND');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/tasks/999",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks", "999"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
